# Todas as variaveis abaixo tem padrao. Um clone novo do repositorio sobe com
# este arquivo vazio — o que falta e validado no boot, com o nome da variavel
# na mensagem de erro (packages/config).

# Porta do servidor de signaling.
# ATENCAO: no Render, defina PORT=10000 — a plataforma nao injeta a variavel.
PORT=3001

# Interface de escuta. Dentro de container tem que ser 0.0.0.0: escutar so no
# loopback esconde o processo da plataforma, que conclui que ele nao subiu.
HOST=0.0.0.0

# Origens permitidas no CORS, separadas por virgula.
# Em producao: a URL da Vercel.
CORS_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
# debug mostra a negociacao WebRTC inteira — e a primeira coisa a olhar
# quando a tela nao aparece do outro lado.
LOG_LEVEL=info

# Postgres (Neon). Vazio = salas so em memoria, como na Phase 0.
DATABASE_URL=

# --------------------------------------------------------------------- ICE
# O servidor monta a configuracao de STUN/TURN e serve em GET /ice. O cliente
# pergunta em vez de carregar embutido — credencial de TURN nao pode ir no
# bundle do browser.

# Servidores STUN, separados por virgula. O padrao ja cobre o caso comum.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Servidores TURN, separados por virgula. Vazio = so STUN.
# Ex.: turn:turn.exemplo.com:3478?transport=udp,turns:turn.exemplo.com:5349
TURN_URLS=

# --- Modo 1 (preferido): credencial que expira ---
# Segredo compartilhado do TURN REST API (coturn e compativeis). O servidor
# deriva usuario e senha validos por TURN_TTL_SECONDS.
TURN_SECRET=
TURN_TTL_SECONDS=3600

# --- Modo 2: credencial fixa ---
# Para provedor que nao oferece segredo compartilhado. Nao expira.
# Nao combine com TURN_SECRET — o boot recusa a configuracao ambigua.
TURN_USERNAME=
TURN_PASSWORD=
